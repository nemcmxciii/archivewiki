
// --- ArchiveWiki offline defaults (added once after setup; edit or remove freely) ---
$conf['updatecheck'] = 0;   // offline-first: DokuWiki doesn't phone home (ArchiveWiki has its own update prompt)
$conf['dnslookups']  = 0;
$conf['userewrite']  = 0;   // plain doku.php?id=... URLs (no rewrite rules needed)
